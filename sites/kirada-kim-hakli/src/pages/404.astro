---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import { url } from "../lib/url";
---
<Base title="Sayfa bulunamadı — Kirada kim haklı?" description="Aradığınız sayfa bulunamadı." path="/404/">
  <div class="wrap narrow" style="padding:64px 0;text-align:center">
    <p class="kicker">404</p>
    <h1 style="font-size:clamp(26px,5.2vw,40px);margin:10px 0 12px;font-weight:900">Sayfa bulunamadı</h1>
    <p style="color:var(--ink-2);margin:0 0 24px">Senaryolardan arayarak devam edebilirsiniz.</p>
    <div style="display:flex;justify-content:center"><SearchBox /></div>
    <p style="margin-top:24px"><a href={url("/senaryolar/")}>Tüm senaryolara göz atın →</a></p>
  </div>
</Base>

---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import CaseCard from "../components/CaseCard.astro";
import Duel from "../components/Duel.astro";
import { cases, frames, related, neighbours, sideLabel, type Case } from "../lib/cases";
import { url, absUrl } from "../lib/url";

export function getStaticPaths() {
  return cases.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
interface Props { item: Case }
const { item } = Astro.props as Props;
const f = frames[item.frame];
const rel = related(item);
const { prev, next } = neighbours(item);
const dateTr = new Intl.DateTimeFormat("tr-TR", { day: "numeric", month: "long", year: "numeric" }).format(new Date(item.updated));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Ana sayfa", item: absUrl("/") },
      { "@type": "ListItem", position: 2, name: "Senaryolar", item: absUrl("/senaryolar/") },
      { "@type": "ListItem", position: 3, name: item.title },
    ]},
    { "@type": "FAQPage", mainEntity: [{ "@type": "Question", name: item.question,
      acceptedAnswer: { "@type": "Answer", text: `${sideLabel[item.verdict]}. ${item.summary}` } }] },
  ],
};
---
<Base
  title={`${item.title} — kirada kim haklı?`}
  description={`${item.question} ${sideLabel[item.verdict]}. ${item.summary}`}
  path={`/${item.slug}/`}
  jsonLd={jsonLd}
>
  <div class="wrap narrow">
    <nav class="crumbs"><a href={url("/")}>Ana sayfa</a><span>/</span><a href={url("/senaryolar/")}>Senaryolar</a><span>/</span>{item.topic}</nav>
    <header class="dh">
      <p class="kicker">{item.topic} · {f.short}</p>
      <h1>{item.question}</h1>
      <div class="meta"><span>Son güncelleme: {dateTr}</span><button class="copy" data-copy>Bağlantıyı kopyala</button></div>
    </header>

    <Duel slug={item.slug} mode="single" title="Önce sen karar ver" />

    <section class="sec" style="margin-top:8px"><h2>Durum</h2><p>{item.situation}</p></section>
    <section class="sec"><h2>Kanun ne diyor</h2><p>{item.legal}</p></section>
    <section class="sec"><h2>Pratik ipucu</h2><div class="tipbox"><b>Uygulamada</b>{item.tip}</div></section>

    <section class="sec">
      <h2>Süre ve başvuru</h2>
      <dl class="facts">
        <div class="fact"><dt>Nereye başvurulur</dt><dd>{f.where}</dd></div>
        <div class="fact"><dt>Süre</dt><dd>{f.deadline}</dd></div>
      </dl>
    </section>

    <section class="sec">
      <h2>Dayanak</h2>
      <p>{f.explain}</p>
      <ul class="laws">{f.basis.map((b) => (<li><b>{b.law}</b>{b.article !== "-" && <> <code>{b.article}</code></>} — {b.note}</li>))}</ul>
    </section>

    {rel.length > 0 && (
      <section class="sec"><h2>Benzer senaryolar</h2><div class="grid g2">{rel.map((r) => <CaseCard item={r} hide />)}</div></section>
    )}

    <section class="sec">
      <h2>Araçlar</h2>
      <div class="grid g2">
        <a class="tool" href={url("/tahliye-testi/")}><span class="ic">🚪</span><span><h3>Tahliye testi</h3><p>4 soruda durumunu değerlendir.</p></span></a>
        <a class="tool" href={url("/ihtarname/")}><span class="ic">✉️</span><span><h3>İhtar oluştur</h3><p>Kopyalanabilir taslak metin.</p></span></a>
      </div>
    </section>

    <nav class="pager">
      {prev ? <a href={url(`/${prev.slug}/`)}><small>← Önceki</small>{prev.title}</a> : <span />}
      {next ? <a class="nx" href={url(`/${next.slug}/`)}><small>Sonraki →</small>{next.title}</a> : <span />}
    </nav>

    <section class="sec" style="border-bottom:0"><h2>Başka bir durum ara</h2><SearchBox placeholder="Örn. depozito, ihtar, aidat…" /></section>
    <div style="height:26px"></div>
  </div>
  <script is:inline>
    document.querySelector("[data-copy]")?.addEventListener("click", async (e) => {
      const b = e.currentTarget;
      try { await navigator.clipboard.writeText(location.href); const o = b.textContent; b.textContent = "Kopyalandı ✓"; setTimeout(() => (b.textContent = o), 1800); } catch {}
    });
  </script>
</Base>

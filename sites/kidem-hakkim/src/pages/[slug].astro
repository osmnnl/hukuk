---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import CaseCard from "../components/CaseCard.astro";
import Verdict from "../components/Verdict.astro";
import { cases, frames, related, neighbours, verdictLabel, type Case } from "../lib/cases";
import { url, absUrl } from "../lib/url";

export function getStaticPaths() {
  return cases.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
interface Props { item: Case }
const { item } = Astro.props as Props;
const f = frames[item.frame];
const rel = related(item);
const { prev, next } = neighbours(item);
const dateTr = new Intl.DateTimeFormat("tr-TR", { day: "numeric", month: "long", year: "numeric" }).format(new Date(item.updated));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Ana sayfa", item: absUrl("/") },
      { "@type": "ListItem", position: 2, name: "Haklarım", item: absUrl("/haklarim/") },
      { "@type": "ListItem", position: 3, name: item.title },
    ]},
    { "@type": "FAQPage", mainEntity: [{ "@type": "Question", name: item.question,
      acceptedAnswer: { "@type": "Answer", text: `${verdictLabel[item.verdict]}. ${item.summary}` } }] },
  ],
};
---
<Base
  title={`${item.title} — Kıdem Hakkım`}
  description={`${item.question} ${verdictLabel[item.verdict]}. ${item.summary}`}
  path={`/${item.slug}/`}
  jsonLd={jsonLd}
>
  <div class="wrap narrow">
    <nav class="crumbs"><a href={url("/")}>Ana sayfa</a><span>/</span><a href={url("/haklarim/")}>Haklarım</a><span>/</span>{item.topic}</nav>
    <header class="dh">
      <p class="kick">{item.topic} · {f.short}</p>
      <h1>{item.question}</h1>
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:14px">
        <Verdict v={item.verdict} lg />
        <strong style="font-size:16px">{verdictLabel[item.verdict]}</strong>
      </div>
      <p style="color:var(--ink-2);font-size:17px;margin:0 0 14px;max-width:68ch">{item.summary}</p>
      <div class="meta"><span>Son güncelleme: {dateTr}</span><button class="copy" data-copy>Bağlantıyı kopyala</button></div>
    </header>

    <section class="sec"><h2>Durum</h2><p>{item.situation}</p></section>
    <section class="sec"><h2>Kanun ne diyor</h2><p>{item.legal}</p></section>
    <section class="sec"><h2>Ne talep edebilirsin</h2><ul class="checks">{item.rights.map((r) => <li>{r}</li>)}</ul></section>
    <section class="sec"><h2>Pratik ipucu</h2><div class="tipbox"><b>Uygulamada</b>{item.tip}</div></section>

    <section class="sec">
      <h2>Süre ve başvuru</h2>
      <dl class="facts">
        <div class="fact"><dt>Süre</dt><dd>{f.deadline}</dd></div>
        <div class="fact"><dt>Nereye başvurulur</dt><dd>{f.where}</dd></div>
      </dl>
    </section>

    <section class="sec">
      <h2>Dayanak</h2>
      <p>{f.explain}</p>
      <ul class="laws">{f.basis.map((b) => (<li><b>{b.law}</b> <code>{b.article}</code> — {b.note}</li>))}</ul>
    </section>

    <section class="sec">
      <h2>Hesapla</h2>
      <div class="grid g2">
        <a class="tool" href={url("/hesapla/")}><span class="ic">🧮</span><span><h3>Tazminat hesabı</h3><p>Ne kadar alacağını gör.</p></span></a>
        <a class="tool" href={url("/fesih-testi/")}><span class="ic">🧭</span><span><h3>Fesih testi</h3><p>Hangi hakların doğdu?</p></span></a>
      </div>
    </section>

    {rel.length > 0 && (
      <section class="sec"><h2>Bunlar da sorulanlar</h2><div class="grid g2">{rel.map((r) => <CaseCard item={r} hide />)}</div></section>
    )}

    <nav class="pager">
      {prev ? <a href={url(`/${prev.slug}/`)}><small>← Önceki</small>{prev.title}</a> : <span />}
      {next ? <a class="nx" href={url(`/${next.slug}/`)}><small>Sonraki →</small>{next.title}</a> : <span />}
    </nav>
    <section class="sec" style="border-bottom:0"><h2>Başka bir durum ara</h2><SearchBox /></section>
    <div style="height:26px"></div>
  </div>
  <script is:inline>
    document.querySelector("[data-copy]")?.addEventListener("click", async (e) => {
      const b = e.currentTarget;
      try { await navigator.clipboard.writeText(location.href); const o = b.textContent; b.textContent = "Kopyalandı ✓"; setTimeout(() => (b.textContent = o), 1800); } catch {}
    });
  </script>
</Base>

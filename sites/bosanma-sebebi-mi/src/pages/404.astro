---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import { url } from "../lib/url";
---
<Base title="Sayfa bulunamadı — Boşanma sebebi mi?" description="Aradığınız sayfa bulunamadı." path="/404/">
  <div class="wrap narrow" style="padding:70px 0;text-align:center">
    <p class="eyebrow">404</p>
    <h1 style="font-size:clamp(27px,5.4vw,40px);margin:10px 0 12px">Sayfa bulunamadı</h1>
    <p style="color:var(--ink-2);margin:0 0 26px">Sözlükten arayarak devam edebilirsiniz.</p>
    <div style="display:flex;justify-content:center"><SearchBox /></div>
    <p style="margin-top:26px"><a href={url("/senaryolar/")}>Tüm senaryolara göz atın →</a></p>
  </div>
</Base>

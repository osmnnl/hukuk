---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import CaseCard from "../components/CaseCard.astro";
import GuessCard from "../components/GuessCard.astro";
import { cases, frames, related, neighbours, verdictLabel, aloneLabel, type Case } from "../lib/cases";
import { url, absUrl } from "../lib/url";

export function getStaticPaths() {
  return cases.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
interface Props { item: Case }
const { item } = Astro.props as Props;
const f = frames[item.frame];
const rel = related(item);
const { prev, next } = neighbours(item);
const path = `/${item.slug}/`;
const dateTr = new Intl.DateTimeFormat("tr-TR", { day: "numeric", month: "long", year: "numeric" }).format(new Date(item.updated));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Ana sayfa", item: absUrl("/") },
      { "@type": "ListItem", position: 2, name: "Sözlük", item: absUrl("/senaryolar/") },
      { "@type": "ListItem", position: 3, name: item.title },
    ]},
    { "@type": "FAQPage", mainEntity: [{ "@type": "Question", name: item.question,
      acceptedAnswer: { "@type": "Answer", text: `${verdictLabel[item.verdict]}. ${item.summary}` } }] },
  ],
};
---
<Base
  title={`${item.title} — boşanmada kusur mu? | Boşanma sebebi mi?`}
  description={`${item.question} ${verdictLabel[item.verdict]}. ${item.summary}`}
  path={path}
  jsonLd={jsonLd}
>
  <div class="wrap narrow">
    <nav class="crumbs">
      <a href={url("/")}>Ana sayfa</a><span>/</span>
      <a href={url("/senaryolar/")}>Sözlük</a><span>/</span>{item.category}
    </nav>

    <header class="dh">
      <p class="eyebrow">{item.category} · {f.short}</p>
      <h1>{item.question}</h1>
      <div class="meta">
        <span>Son güncelleme: {dateTr}</span>
        <button class="copy" data-copy>Bağlantıyı kopyala</button>
      </div>
    </header>

    <GuessCard slug={item.slug} mode="single" title="Önce tahmin et" />

    <section class="sec" style="margin-top:10px">
      <h2>Durum ne anlama geliyor</h2>
      <p>{item.situation}</p>
    </section>

    <section class="sec">
      <h2>Hukuki değerlendirme</h2>
      <p>{item.legal}</p>
    </section>

    <section class="sec">
      <h2>Bu senaryoda ölçüler</h2>
      <dl class="facts">
        <div class="fact"><dt>Ağırlık</dt><dd>{"●".repeat(item.weight)}{"○".repeat(5 - item.weight)} <span style="color:var(--ink-3);font-size:13px">({item.weight}/5)</span></dd></div>
        <div class="fact"><dt>Tek başına yeterli mi</dt><dd>{aloneLabel[item.alone]}</dd></div>
        <div class="fact"><dt>Süre</dt><dd>{f.deadline}</dd></div>
        <div class="fact"><dt>Sonuçları</dt><dd>{f.consequence}</dd></div>
      </dl>
    </section>

    <section class="sec">
      <h2>Nasıl ispatlanır</h2>
      <p>{f.evidence}</p>
    </section>

    <section class="sec">
      <h2>Hangi sebebe dayanır</h2>
      <p>{f.explain}</p>
      <ul class="laws">
        {f.basis.map((b) => (
          <li><b>{b.law}</b>{b.article !== "-" && <> <code>{b.article}</code></>} — {b.note}</li>
        ))}
      </ul>
    </section>

    {rel.length > 0 && (
      <section class="sec">
        <h2>Bunlar da merak ediliyor</h2>
        <div class="grid g2">{rel.map((r) => <CaseCard item={r} hideVerdict />)}</div>
      </section>
    )}

    <section class="sec">
      <h2>Devam et</h2>
      <div class="grid g2">
        <a class="feature" href={url("/test/")}><span class="ico">🎯</span><span><h3>Kusur testi</h3><p>12 soruda sezgini ölç.</p></span></a>
        <a class="feature" href={url("/terazi/")}><span class="ico">⚖️</span><span><h3>Kusur terazisi</h3><p>Hangisi daha ağır?</p></span></a>
      </div>
    </section>

    <nav class="pager">
      {prev ? <a href={url(`/${prev.slug}/`)}><small>← Önceki</small>{prev.title}</a> : <span />}
      {next ? <a class="nx" href={url(`/${next.slug}/`)}><small>Sonraki →</small>{next.title}</a> : <span />}
    </nav>

    <section class="sec" style="border-bottom:0">
      <h2>Başka bir davranış ara</h2>
      <SearchBox placeholder="Örn. hakaret, terk, nafaka…" />
    </section>
    <div style="height:30px"></div>
  </div>

  <script is:inline>
    document.querySelector("[data-copy]")?.addEventListener("click", async (e) => {
      const b = e.currentTarget;
      try { await navigator.clipboard.writeText(location.href); const o = b.textContent; b.textContent = "Kopyalandı ✓"; setTimeout(() => (b.textContent = o), 1800); } catch {}
    });
  </script>
</Base>

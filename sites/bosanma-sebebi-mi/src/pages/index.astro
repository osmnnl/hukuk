---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import CaseCard from "../components/CaseCard.astro";
import GuessCard from "../components/GuessCard.astro";
import { cases, surprising, notFault, aloneEnough } from "../lib/cases";
import { url, absUrl } from "../lib/url";

const populer = ["eve-gec-gelmek","zina-yapmak","esi-ailesiyle-gorusturmeme","bagimsiz-konut-saglamama","guven-sarsici-mesajlasma","ev-islerine-yardim-etmemek"]
  .map((s) => cases.find((c) => c.slug === s)!);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": absUrl("/") + "#website", name: "Boşanma sebebi mi?", url: absUrl("/"), inLanguage: "tr-TR" },
    { "@type": "FAQPage", mainEntity: populer.map((c) => ({ "@type": "Question", name: c.question, acceptedAnswer: { "@type": "Answer", text: c.summary } })) },
  ],
};
---
<Base
  title="Boşanma sebebi mi? — Sence bu davranış kusur mu?"
  description="Eve geç gelmek, hakaret, aldatma, ev işlerine yardım etmemek… Boşanma davalarında hangi davranış kusur sayılır? Önce tahmin edin, sonra Yargıtay uygulamasındaki karşılığını görün."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Kusur sözlüğü · {cases.length} davranış</p>
      <h1>Sence bu<br />boşanma sebebi mi?</h1>
      <p class="lede">
        Tahmin et, sonra Yargıtay uygulamasındaki karşılığını gör. Çoğu insan en az üçte birinde yanılıyor.
      </p>
      <GuessCard mode="random" title="Günün sorusu" />
    </div>
  </section>

  <section class="block" style="padding-top:14px">
    <div class="wrap">
      <div class="grid g3">
        <a class="feature" href={url("/test/")}>
          <span class="ico">🎯</span>
          <span><h3>Kusur testi</h3><p>12 soru, 2 dakika. Hukuk sezgin ne kadar iyi?</p></span>
        </a>
        <a class="feature" href={url("/terazi/")}>
          <span class="ico">⚖️</span>
          <span><h3>Kusur terazisi</h3><p>Hangisi daha ağır kusur? İkisinden birini seç.</p></span>
        </a>
        <a class="feature" href={url("/listeler/")}>
          <span class="ico">💡</span>
          <span><h3>Şaşırtıcı listeler</h3><p>Herkesin yanlış bildiği {surprising.length} davranış.</p></span>
        </a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="head"><h2>Bir davranış ara</h2></div>
      <SearchBox />
    </div>
  </section>

  <section class="block" style="padding-top:10px">
    <div class="wrap">
      <div class="head">
        <h2>En çok merak edilenler</h2>
        <a href={url("/senaryolar/")}>Tüm sözlük ({cases.length}) →</a>
      </div>
      <div class="grid g2">{populer.map((c) => <CaseCard item={c} />)}</div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="head">
        <h2>Kusur sanılıyor ama değil</h2>
        <a href={url("/listeler/kusur-sanilan/")}>Listenin tamamı →</a>
      </div>
      <div class="grid g2">{notFault.slice(0, 4).map((c) => <CaseCard item={c} hideVerdict />)}</div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="head">
        <h2>Tek başına dava sebebi olabilenler</h2>
        <a href={url("/listeler/tek-basina/")}>Listenin tamamı →</a>
      </div>
      <div class="grid g2">{aloneEnough.slice(0, 4).map((c) => <CaseCard item={c} />)}</div>
    </div>
  </section>
</Base>

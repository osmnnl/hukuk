---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import CaseCard from "../components/CaseCard.astro";
import { cases, surprising, site } from "../lib/cases";
import { url, absUrl } from "../lib/url";

const populer = ["es-ve-cocuklar-nasil-paylasir","cocuk-yoksa-kim-mirasci","sakli-pay-nedir","mal-kacirma-tenkis","miras-borca-batik","esin-mal-rejimi-alacagi"]
  .map((s) => cases.find((c) => c.slug === s)!);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": absUrl("/") + "#website", name: site.name, url: absUrl("/"), inLanguage: "tr-TR" },
    { "@type": "FAQPage", mainEntity: populer.map((c) => ({ "@type": "Question", name: c.question, acceptedAnswer: { "@type": "Answer", text: c.summary } })) },
  ],
};
---
<Base
  title="Miras Kimin? — kim ne kadar pay alır?"
  description="Eş, çocuk, anne-baba, kardeş… Miras kime, ne oranda kalır? Aile durumunu işaretleyin, paylar zümre sistemine göre anında hesaplansın. Saklı pay ve tenkis de burada."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="kick">{cases.length} soru · pay hesabı · saklı pay</p>
      <h1>Miras kimin,<br />kim ne kadar alır?</h1>
      <p class="lede">
        Türk miras hukuku zümre sistemine dayanır: önceki zümrede mirasçı varsa sonraki zümre hiç pay almaz.
        Aileyi işaretleyin, payları görün.
      </p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a class="btn" href={url("/pay-hesabi/")}>Payları hesapla →</a>
        <a class="btn btn-2" href={url("/sakli-pay/")}>Saklı pay nedir?</a>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:18px"><div class="wrap">
    <div class="grid g3">
      <a class="tool" href={url("/pay-hesabi/")}><span class="ic">👪</span><span><h3>Pay hesabı</h3><p>Eş, çocuk, anne-baba, kardeş — kim ne kadar?</p></span></a>
      <a class="tool" href={url("/sakli-pay/")}><span class="ic">🔒</span><span><h3>Saklı pay</h3><p>Ne kadarı dokunulmaz, ne kadarı serbest?</p></span></a>
      <a class="tool" href={url("/liste/")}><span class="ic">📜</span><span><h3>{cases.length} soru</h3><p>Vasiyet, tenkis, ret, paylaşma, vergi.</p></span></a>
    </div>
  </div></section>

  <section class="block" style="padding-top:0"><div class="wrap">
    <div class="head"><h2>Sorunu ara</h2></div><SearchBox placeholder="Ara: saklı pay, vasiyet, reddi miras…" />
  </div></section>

  <section class="block" style="padding-top:10px"><div class="wrap">
    <div class="head"><h2>En çok sorulanlar</h2><a href={url("/liste/")}>Tüm sorular ({cases.length}) →</a></div>
    <div class="grid g2">{populer.map((c) => <CaseCard item={c} />)}</div>
  </div></section>

  <section class="block" style="padding-top:0"><div class="wrap">
    <div class="head"><h2>Çoğu kişinin yanıldığı {surprising.length} nokta</h2></div>
    <div class="grid g2">{surprising.slice(0, 6).map((c) => <CaseCard item={c} hide />)}</div>
  </div></section>
</Base>

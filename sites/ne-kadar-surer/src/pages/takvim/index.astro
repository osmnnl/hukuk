---
import Base from "../../layouts/Base.astro";
import { url } from "../../lib/url";

const sureler = [
  { id: "istinaf", ad: "İstinaf başvurusu", miktar: 2, birim: "hafta", baslangic: "Kararın tebliği", dayanak: "6100 HMK m.345", not: "Süre geçerse karar kesinleşir; eski hâle getirme çok dar hâllerde mümkündür." },
  { id: "temyiz", ad: "Temyiz başvurusu", miktar: 2, birim: "hafta", baslangic: "İstinaf kararının tebliği", dayanak: "6100 HMK m.361", not: "Parasal sınırın altındaki uyuşmazlıklarda temyiz yolu kapalıdır." },
  { id: "odeme-emri", ad: "Ödeme emrine itiraz", miktar: 7, birim: "gun", baslangic: "Ödeme emrinin tebliği", dayanak: "2004 İİK m.62", not: "İtiraz edilmezse takip kesinleşir ve haciz başlar." },
  { id: "takipsizlik", ad: "Takipsizlik kararına itiraz", miktar: 15, birim: "gun", baslangic: "Kararın tebliği", dayanak: "5271 CMK m.173", not: "İtiraz, kararı veren savcılığın bağlı olduğu sulh ceza hâkimliğine yapılır." },
  { id: "hakem-heyeti", ad: "Tüketici hakem heyeti kararına itiraz", miktar: 15, birim: "gun", baslangic: "Kararın tebliği", dayanak: "6502 TKHK m.70", not: "İtiraz tüketici mahkemesine yapılır; karar icrayı durdurmaz." },
  { id: "idari-dava", ad: "İdari işleme karşı dava", miktar: 60, birim: "gun", baslangic: "İşlemin tebliği", dayanak: "2577 İYUK m.7", not: "İdareye başvurup cevap beklerken süre işlemeye devam eder." },
  { id: "vergi-dava", ad: "Vergi/ceza ihbarnamesine dava", miktar: 30, birim: "gun", baslangic: "İhbarnamenin tebliği", dayanak: "2577 İYUK m.7", not: "Uzlaşma talebi bu süreyi durdurur." },
  { id: "sikayet", ad: "Ceza şikâyeti (takibi şikâyete bağlı suçlar)", miktar: 6, birim: "ay", baslangic: "Fiili ve faili öğrenme", dayanak: "5237 TCK m.73", not: "Hakaret, tehdit gibi suçlarda süre kaçarsa dava açılamaz." },
  { id: "arabuluculuk-dava", ad: "Arabuluculuk son tutanağından sonra dava", miktar: 2, birim: "hafta", baslangic: "Son tutanağın düzenlenmesi", dayanak: "7036 İş Mah. K. m.3", not: "İşe iade davasında bu süre hak düşürücüdür." },
  { id: "ise-iade-basvuru", ad: "İşe iade kararından sonra işverene başvuru", miktar: 10, birim: "isgunu", baslangic: "Kararın kesinleşmesinin tebliği", dayanak: "4857 İş K. m.21", not: "Başvurulmazsa fesih geçerli hâle gelir ve kazanılan dava sonuçsuz kalır." },
  { id: "fesih-itiraz", ad: "Fesih bildirimine karşı arabuluculuğa başvuru", miktar: 1, birim: "ay", baslangic: "Fesih bildiriminin tebliği", dayanak: "4857 İş K. m.20", not: "İşe iade isteyen işçi için hak düşürücü süredir." },
  { id: "bilirkisi-itiraz", ad: "Bilirkişi raporuna itiraz", miktar: 2, birim: "hafta", baslangic: "Raporun tebliği", dayanak: "6100 HMK m.281", not: "İtiraz edilmezse rapor hükme esas alınır." },
  { id: "tedbir-dava", ad: "İhtiyati tedbirden sonra esas dava", miktar: 2, birim: "hafta", baslangic: "Tedbir kararının uygulanması", dayanak: "6100 HMK m.397", not: "Dava açılmazsa tedbir kendiliğinden kalkar." },
  { id: "mirasin-reddi", ad: "Mirasın reddi", miktar: 3, birim: "ay", baslangic: "Mirasçı olunduğunun öğrenilmesi", dayanak: "4721 TMK m.606", not: "Süre geçerse miras, borçlarıyla birlikte kabul edilmiş sayılır." },
  { id: "aym", ad: "Anayasa Mahkemesi bireysel başvurusu", miktar: 30, birim: "gun", baslangic: "Olağan kanun yollarının tükenmesi", dayanak: "6216 sayılı Kanun m.47", not: "Başvuru yolları tüketilmeden yapılan başvuru kabul edilemez bulunur." },
  { id: "bilgi-edinme-itiraz", ad: "Bilgi edinme reddine itiraz", miktar: 15, birim: "gun", baslangic: "Ret kararının tebliği", dayanak: "4982 sayılı Kanun m.13", not: "Kurula itiraz, idari dava açma süresini durdurur." }
];
---
<Base
  title="Hukuki süre takvimi — kaç günüm kaldı?"
  description="İstinaf, itiraz, şikâyet, idari dava… Tebliğ tarihini girin, son günü ve kalan süreyi görün. 16 yasal süre tek sayfada."
  path="/takvim/"
>
  <section class="hero" style="padding-bottom:16px">
    <div class="wrap narrow">
      <p class="kick">Süre takvimi</p>
      <h1>Kaç günüm<br />kaldı?</h1>
      <p class="lede">Hukukta en çok kaybedilen hak, haklı olunmadığı için değil; süre kaçırıldığı için kaybediliyor. Tarihi girin, son günü görün.</p>
    </div>
  </section>

  <div class="wrap narrow" style="padding-bottom:36px">
    <div class="panel">
      <div class="field">
        <label for="tur">Hangi süre?</label>
        <select id="tur">{sureler.map((s) => <option value={s.id}>{s.ad}</option>)}</select>
        <p class="hint" id="baslangicHint"></p>
      </div>
      <div class="field">
        <label for="tarih">Başlangıç tarihi</label>
        <input id="tarih" type="date" />
      </div>
      <button class="btn" type="button" id="hesapla" style="width:100%">Son günümü göster</button>

      <div id="sonuc" hidden style="margin-top:22px">
        <div class="total">
          <p class="lbl" id="durumLbl">Kalan süre</p>
          <p class="big num" id="kalan"></p>
          <p class="sub" id="sonTarih"></p>
        </div>
        <div class="lines" id="detay"></div>
        <div class="tipbox" id="notbox" style="margin-top:14px"></div>
      </div>
    </div>

    <section class="sec" style="margin-top:30px">
      <h2>Süre nasıl hesaplanır?</h2>
      <p>Süre, tebliğ edildiği <strong>günü saymadan</strong> ertesi gün işlemeye başlar. Son gün resmî tatile
      denk gelirse süre, tatili izleyen ilk iş gününün çalışma saati bitiminde sona erer. Bu sayfa hafta
      sonlarını hesaba katar ancak <strong>resmî tatilleri bilmez</strong> — son gün bir tatile denk geliyorsa
      lehinize bir gün daha olabilir. Yine de son güne bırakmayın.</p>
    </section>
    <p class="note">Buradaki süreler genel kuraldır; özel kanunlarda farklı süreler bulunabilir ve süre
    hesabı dosyanızdaki tebliğ belgesine göre yapılır. Kritik bir süre söz konusuysa avukatınıza doğrulatın.</p>
  </div>

  <script is:inline define:vars={{ sureler }}>
    const $ = (id) => document.getElementById(id);
    const fmt = (d) => d.toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" });
    const birimAd = { gun: "gün", hafta: "hafta", ay: "ay", isgunu: "iş günü" };

    function sonGun(bas, s) {
      const d = new Date(bas.getTime());
      if (s.birim === "gun") d.setDate(d.getDate() + s.miktar);
      else if (s.birim === "hafta") d.setDate(d.getDate() + s.miktar * 7);
      else if (s.birim === "ay") {
        const g = d.getDate();
        d.setDate(1); d.setMonth(d.getMonth() + s.miktar);
        const sonGunAy = new Date(d.getFullYear(), d.getMonth() + 1, 0).getDate();
        d.setDate(Math.min(g, sonGunAy));
      }
      else { let k = s.miktar; while (k > 0) { d.setDate(d.getDate() + 1); const g = d.getDay(); if (g !== 0 && g !== 6) k--; } }
      const g = d.getDay();
      if (g === 6) d.setDate(d.getDate() + 2);
      else if (g === 0) d.setDate(d.getDate() + 1);
      return d;
    }

    function hintYaz() {
      const s = sureler.find((x) => x.id === $("tur").value);
      $("baslangicHint").textContent = `Süre şuradan işler: ${s.baslangic.toLocaleLowerCase("tr")}. Dayanak: ${s.dayanak}.`;
    }

    $("tur").addEventListener("change", hintYaz);
    hintYaz();

    $("hesapla").addEventListener("click", () => {
      const s = sureler.find((x) => x.id === $("tur").value);
      const v = $("tarih").value;
      if (!v) { $("tarih").focus(); return; }
      const bas = new Date(v + "T00:00:00");
      const son = sonGun(bas, s);
      const bugun = new Date(); bugun.setHours(0, 0, 0, 0);
      const kalan = Math.round((son - bugun) / 86400000);

      $("durumLbl").textContent = kalan < 0 ? "Süre geçmiş görünüyor" : kalan === 0 ? "Son gün bugün" : "Kalan süre";
      $("kalan").textContent = kalan < 0 ? `${Math.abs(kalan).toLocaleString("tr-TR")} gün geçti` : `${kalan.toLocaleString("tr-TR")} gün`;
      $("sonTarih").textContent = `Son gün: ${fmt(son)}`;

      $("detay").innerHTML = [
        ["Süre", `${s.miktar} ${birimAd[s.birim]}`],
        ["Başlangıç", fmt(bas)],
        ["Son gün", fmt(son)],
        ["Dayanak", s.dayanak]
      ].map(([k, v2]) => `<div class="line"><span class="k">${k}</span><span class="v">${v2}</span></div>`).join("");

      $("notbox").innerHTML = kalan < 0
        ? `<b>Süre dolmuş görünüyor.</b> Yine de vazgeçmeden önce başlangıç tarihini doğrulayın: süre tebliğ tarihinden işler, kararın verildiği tarihten değil. ${s.not}`
        : `<b>Dikkat:</b> ${s.not}`;
      $("sonuc").hidden = false;
      $("sonuc").scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  </script>
</Base>

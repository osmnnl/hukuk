---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import CaseCard from "../components/CaseCard.astro";
import { cases, surprising, site } from "../lib/cases";
import { url, absUrl } from "../lib/url";

const populer = ["ayni-sifre","iki-adimli-dogrulama","otp-paylasma","sifre-uzunlugu","parola-yoneticisi","veri-sizintisi-ne-yapmali"]
  .map((s) => cases.find((c) => c.slug === s)!);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": absUrl("/") + "#website", name: site.name, url: absUrl("/"), inLanguage: "tr-TR" },
    { "@type": "FAQPage", mainEntity: populer.map((c) => ({ "@type": "Question", name: c.question, acceptedAnswer: { "@type": "Answer", text: c.summary } })) },
  ],
};
---
<Base
  title="Şifrem güvenli mi? — şifre gücü, 2FA ve veri sızıntısı"
  description="Şifrenizin ne kadar sürede kırılacağını ölçün, hesap güvenliği karnenizi çıkarın: 2FA, sızıntı, kimlik avı ve cihaz güvenliği."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="kick">{cases.length} güvenlik sorusu · şifre testi · karne</p>
      <h1>Şifrem<br />güvenli mi?</h1>
      <p class="lede">
        Hesapların çoğu <strong>şifre kırılarak değil</strong>, başka bir sitede sızmış şifre denenerek ya da
        kullanıcı kodu kendi eliyle vererek kaybediliyor.
      </p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a class="btn" href={url("/test/")}>Şifremi test et →</a>
        <a class="btn btn-2" href={url("/karne/")}>Güvenlik karnem</a>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:20px"><div class="wrap">
    <div class="grid g3">
      <a class="tool" href={url("/test/")}><span class="ic">🔐</span><span><h3>Şifre testi</h3><p>Kaç saniyede kırılır? Tamamen cihazında çalışır.</p></span></a>
      <a class="tool" href={url("/karne/")}><span class="ic">📋</span><span><h3>Güvenlik karnesi</h3><p>12 soru, 23 puan — açık kalemini gör.</p></span></a>
      <a class="tool" href={url("/liste/")}><span class="ic">🛡️</span><span><h3>{cases.length} soru</h3><p>Şifre, 2FA, sızıntı, dolandırıcılık, cihaz.</p></span></a>
    </div>
  </div></section>

  <section class="block" style="padding-top:6px"><div class="wrap">
    <div class="head"><h2>Ara</h2></div><SearchBox placeholder="Ara: 2FA, sızıntı, oltalama, passkey…" />
  </div></section>

  <section class="block" style="padding-top:10px"><div class="wrap">
    <div class="head"><h2>En çok sorulanlar</h2><a href={url("/liste/")}>Tümü ({cases.length}) →</a></div>
    <div class="grid g2">{populer.map((c) => <CaseCard item={c} />)}</div>
  </div></section>

  <section class="block" style="padding-top:0"><div class="wrap">
    <div class="head"><h2>Çoğu kişinin yanlış bildiği {surprising.length} şey</h2></div>
    <div class="grid g2">{surprising.slice(0, 6).map((c) => <CaseCard item={c} hide />)}</div>
  </div></section>
</Base>

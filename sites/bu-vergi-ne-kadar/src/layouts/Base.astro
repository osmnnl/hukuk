---
import "../styles/theme.css";
import "../styles/core.css";
import { url, absUrl, BASE } from "../lib/url";
import { site } from "../lib/cases";
import nav from "../data/nav.json";

interface Props { title: string; description: string; path: string; jsonLd?: unknown }
const { title, description, path, jsonLd } = Astro.props;
const canonical = absUrl(path);
// Monorepo'da BASE "/kok/<site>/" olur; kapak sayfası bir üst dizindedir.
const segs = BASE.split("/").filter(Boolean);
const hubUrl = segs.length > 1 ? "/" + segs.slice(0, -1).join("/") + "/" : null;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={url("/sitemap.xml")} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline define:vars={{ key: "th-" + site.name }}>
      (() => { try { const t = localStorage.getItem(key); if (t) document.documentElement.dataset.theme = t; } catch {} })();
    </script>
  </head>
  <body>
    <header class="top">
      <div class="in">
        {hubUrl && <a class="hublink" href={hubUrl} title="Tüm siteler">⚖️ Hakkını Bil</a>}
        <a class="logo" href={url("/")} set:html={site.tagline} />
        <nav class="nav">
          {nav.map((n: { href: string; label: string }) => (
            <a href={url(n.href)} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <button class="tbtn" id="theme" type="button" aria-label="Temayı değiştir">◐</button>
      </div>
    </header>

    <main><slot /></main>

    <footer class="foot">
      <div class="wrap">
        <div class="cols">
          {nav.slice(1).map((n: { href: string; label: string }) => <a href={url(n.href)}>{n.label}</a>)}
          <a href={url("/hakkinda/")}>Hakkında</a>
        </div>
        <p class="note"><slot name="disclaimer">
          Buradaki bilgiler genel bilgilendirme amaçlıdır, hukuki veya finansal danışmanlık değildir.
          Hesaplayıcılar girdiğiniz değerlere göre yaklaşık sonuç üretir; oranlar, sınırlar ve mevzuat
          zamanla değişir. Karar vermeden önce güncel değerleri doğrulayın ve bir uzmana danışın.
        </slot></p>
        <p style="margin-top:16px">© {new Date().getFullYear()} {site.name} · Açık kaynak</p>
      </div>
    </footer>

    <span id="idx" data-base={BASE} data-src={url("/search-index.json")} hidden></span>
    <script is:inline define:vars={{ key: "th-" + site.name, labels: { a: site.verdicts.a.short, b: site.verdicts.b.short, c: site.verdicts.c.short } }}>
      document.getElementById("theme")?.addEventListener("click", () => {
        const el = document.documentElement;
        const next = el.dataset.theme === "light" ? "dark" : "light";
        el.dataset.theme = next;
        try { localStorage.setItem(key, next); } catch {}
      });

      const TR = {"ı":"i","İ":"i","ş":"s","Ş":"s","ğ":"g","Ğ":"g","ü":"u","Ü":"u","ö":"o","Ö":"o","ç":"c","Ç":"c","â":"a","î":"i","û":"u"};
      const norm = (s) => (s || "").toLowerCase().replace(/[ıİşŞğĞüÜöÖçÇâîû]/g, (m) => TR[m] || m);
      const meta = document.getElementById("idx");
      if (meta && document.querySelector("[data-search]")) {
        const BASE = meta.dataset.base || "/";
        let DATA = null, loading = null;
        const load = () => DATA ? Promise.resolve(DATA) : (loading ||= fetch(meta.dataset.src).then(r => r.json())
          .then(rows => (DATA = rows.map(d => ({ ...d, _t: norm(d.t), _q: norm(d.q), _a: norm(d.a), _c: norm(d.c) }))))
          .catch(() => (DATA = [])));
        const score = (d, terms) => {
          let tot = 0;
          for (const t of terms) {
            let b = 0;
            if (d._t.startsWith(t)) b = 100; else if (d._t.includes(t)) b = 70;
            else if (d._a.includes(t)) b = 55; else if (d._q.includes(t)) b = 40; else if (d._c.includes(t)) b = 20;
            if (!b) return 0;
            tot += b;
          }
          return tot;
        };
        const find = (q) => {
          const terms = norm(q).split(/\s+/).filter(Boolean);
          if (!terms.length || !DATA) return [];
          return DATA.map(d => ({ d, s: score(d, terms) })).filter(r => r.s > 0)
            .sort((a, b) => b.s - a.s || a.d._t.length - b.d._t.length).slice(0, 8).map(r => r.d);
        };
        document.querySelectorAll("[data-search]").forEach((root) => {
          const input = root.querySelector("input"), out = root.querySelector("[data-results]");
          if (!input || !out) return;
          let active = -1;
          const render = (list) => {
            active = -1;
            if (!input.value.trim()) { out.innerHTML = ""; return; }
            out.innerHTML = list.length
              ? list.map(d => `<a href="${BASE}${d.s}/"><span class="rt">${d.t}<span class="rc">${d.c}</span></span><span class="tag tag-${d.v}">${labels[d.v]}</span></a>`).join("")
              : `<div class="empty">Eşleşen kayıt yok.</div>`;
          };
          const run = () => load().then(() => render(find(input.value)));
          input.addEventListener("input", run);
          input.addEventListener("focus", () => { load(); if (input.value) run(); });
          input.addEventListener("keydown", (e) => {
            const items = [...out.querySelectorAll("a")];
            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
              if (!items.length) return;
              e.preventDefault();
              active = e.key === "ArrowDown" ? (active + 1) % items.length : (active - 1 + items.length) % items.length;
              items.forEach((el, i) => el.classList.toggle("on", i === active));
              items[active].scrollIntoView({ block: "nearest" });
            } else if (e.key === "Enter") {
              const go = active >= 0 ? items[active] : items[0];
              if (go) { e.preventDefault(); location.href = go.href; }
            } else if (e.key === "Escape") { input.value = ""; out.innerHTML = ""; input.blur(); }
          });
          document.addEventListener("click", (e) => { if (!root.contains(e.target)) out.innerHTML = ""; });
        });
      }
    </script>
  </body>
</html>

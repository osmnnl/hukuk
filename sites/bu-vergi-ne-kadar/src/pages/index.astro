---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import CaseCard from "../components/CaseCard.astro";
import { cases, surprising, site } from "../lib/cases";
import { url, absUrl } from "../lib/url";

const populer = ["ev-alirken-tapu-harci","kira-geliri-beyani","konut-satis-kazanci","miras-vergisi","internetten-satis","beyan-suresini-kacirmak"]
  .map((s) => cases.find((c) => c.slug === s)!);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": absUrl("/") + "#website", name: site.name, url: absUrl("/"), inLanguage: "tr-TR" },
    { "@type": "FAQPage", mainEntity: populer.map((c) => ({ "@type": "Question", name: c.question, acceptedAnswer: { "@type": "Answer", text: c.summary } })) },
  ],
};
---
<Base
  title="Bu vergi ne kadar? — harç, beyan ve vergi haritası"
  description="Ev alımı, kira geliri, araç, miras, e-ticaret… Hangi işlemde hangi vergi çıkar, kim öder, ne zaman beyan edilir? Tapu harcı ve emlak vergisi hesaplayıcısıyla."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="kick">{cases.length} vergi sorusu · bulucu · harç hesabı</p>
      <h1>Bu işlemde<br />vergi ne kadar?</h1>
      <p class="lede">
        Vergi sürpriz olmaz; <strong>önceden sorulmadığı için</strong> sürpriz olur. İşlemi seçin, hangi
        kalemlerin çıkacağını ve kimin ödeyeceğini baştan görün.
      </p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a class="btn" href={url("/bulucu/")}>Vergi bulucuyu aç →</a>
        <a class="btn btn-2" href={url("/harc/")}>Harç hesabı</a>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:20px"><div class="wrap">
    <div class="grid g3">
      <a class="tool" href={url("/bulucu/")}><span class="ic">🧭</span><span><h3>Vergi bulucu</h3><p>8 işlem — hangi vergi, kim öder, ne zaman?</p></span></a>
      <a class="tool" href={url("/harc/")}><span class="ic">🧮</span><span><h3>Harç hesabı</h3><p>Tapu harcı, emlak vergisi, damga vergisi.</p></span></a>
      <a class="tool" href={url("/liste/")}><span class="ic">📑</span><span><h3>{cases.length} soru</h3><p>Gelir, harç, taşınmaz, araç, miras, ticaret.</p></span></a>
    </div>
  </div></section>

  <section class="block" style="padding-top:6px"><div class="wrap">
    <div class="head"><h2>Ara</h2></div><SearchBox placeholder="Ara: tapu harcı, kira beyanı, ÖTV, veraset…" />
  </div></section>

  <section class="block" style="padding-top:10px"><div class="wrap">
    <div class="head"><h2>En çok sorulanlar</h2><a href={url("/liste/")}>Tümü ({cases.length}) →</a></div>
    <div class="grid g2">{populer.map((c) => <CaseCard item={c} />)}</div>
  </div></section>

  <section class="block" style="padding-top:0"><div class="wrap">
    <div class="head"><h2>Çoğu kişiyi şaşırtan {surprising.length} nokta</h2></div>
    <div class="grid g2">{surprising.slice(0, 6).map((c) => <CaseCard item={c} hide />)}</div>
  </div></section>
</Base>

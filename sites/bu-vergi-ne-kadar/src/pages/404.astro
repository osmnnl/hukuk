---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import { url } from "../lib/url";
import { site } from "../lib/cases";
---
<Base title={`Sayfa bulunamadı — ${site.name}`} description="Aradığınız sayfa bulunamadı." path="/404/">
  <div class="wrap narrow" style="padding:64px 0;text-align:center">
    <p class="kick">404</p>
    <h1 style="font-size:clamp(26px,5.2vw,38px);margin:10px 0 12px;font-weight:850">Sayfa bulunamadı</h1>
    <p style="color:var(--ink-2);margin:0 0 24px">Listeden arayarak devam edebilirsiniz.</p>
    <div style="display:flex;justify-content:center"><SearchBox /></div>
    <p style="margin-top:24px"><a href={url("/liste/")}>Tüm kayıtlara göz atın →</a></p>
  </div>
</Base>

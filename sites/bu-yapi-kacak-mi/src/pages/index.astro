---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import CaseCard from "../components/CaseCard.astro";
import { cases, surprising, site } from "../lib/cases";
import { url, absUrl } from "../lib/url";

const populer = ["balkon-kapatma","tasiyici-duvar-kesme","yapi-kayit-belgesi","kacak-yapi-satin-aldim","evi-isyerine-cevirme","tarlaya-ev"]
  .map((s) => cases.find((c) => c.slug === s)!);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": absUrl("/") + "#website", name: site.name, url: absUrl("/"), inLanguage: "tr-TR" },
    { "@type": "FAQPage", mainEntity: populer.map((c) => ({ "@type": "Question", name: c.question, acceptedAnswer: { "@type": "Answer", text: c.summary } })) },
  ],
};
---
<Base
  title="Bu yapı kaçak mı? — ruhsat, tadilat ve imar cezası"
  description="Balkon kapatma, çatı katı, tarlaya ev, dükkânı konuta çevirme… Hangi iş ruhsat ister, hangisi serbest, kaçak yapının sonucu ne?"
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="kick">{cases.length} imar durumu · karar testi · kontrol listesi</p>
      <h1>Bu yapı<br />kaçak mı?</h1>
      <p class="lede">
        Çoğu kaçak yapı, kaçak olmak istendiği için değil; <strong>ruhsat gerektiğini kimse söylemediği</strong>
        için ortaya çıkıyor. Sınır sanılandan çok daha aşağıda.
      </p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a class="btn" href={url("/test/")}>Kaçak mı testini yap →</a>
        <a class="btn btn-2" href={url("/kontrol/")}>Almadan önce kontrol listesi</a>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:20px"><div class="wrap">
    <div class="grid g3">
      <a class="tool" href={url("/test/")}><span class="ic">🚧</span><span><h3>Kaçak mı testi</h3><p>Üç soruda: serbest mi, ruhsatlı mı, kaçak mı?</p></span></a>
      <a class="tool" href={url("/kontrol/")}><span class="ic">🔍</span><span><h3>Satın alma kontrolü</h3><p>17 madde — yapı yasal mı, tek tek bak.</p></span></a>
      <a class="tool" href={url("/liste/")}><span class="ic">📐</span><span><h3>{cases.length} durum</h3><p>Balkondan tarlaya, mühürden yıkıma.</p></span></a>
    </div>
  </div></section>

  <section class="block" style="padding-top:6px"><div class="wrap">
    <div class="head"><h2>Ara</h2></div><SearchBox placeholder="Ara: balkon, çatı, iskân, mühür, tarla…" />
  </div></section>

  <section class="block" style="padding-top:10px"><div class="wrap">
    <div class="head"><h2>En çok sorulanlar</h2><a href={url("/liste/")}>Tümü ({cases.length}) →</a></div>
    <div class="grid g2">{populer.map((c) => <CaseCard item={c} />)}</div>
  </div></section>

  <section class="block" style="padding-top:0"><div class="wrap">
    <div class="head"><h2>Çoğu kişiyi şaşırtan {surprising.length} nokta</h2></div>
    <div class="grid g2">{surprising.slice(0, 6).map((c) => <CaseCard item={c} hide />)}</div>
  </div></section>
</Base>

---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import CaseCard from "../components/CaseCard.astro";
import { cases, surprising, site } from "../lib/cases";
import { url, absUrl } from "../lib/url";

const populer = ["arac-deger-kaybi","is-kazasi-tazminati","destekten-yoksun-kalma","manevi-tazminat-ne-kadar","sigorta-eksik-odedi","zamanasimi-kacti-mi"]
  .map((s) => cases.find((c) => c.slug === s)!);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": absUrl("/") + "#website", name: site.name, url: absUrl("/"), inLanguage: "tr-TR" },
    { "@type": "FAQPage", mainEntity: populer.map((c) => ({ "@type": "Question", name: c.question, acceptedAnswer: { "@type": "Answer", text: c.summary } })) },
  ],
};
---
<Base
  title="Tazminat Hesabı — bu durumda ne kadar tazminat alırım?"
  description="Trafik kazası, iş kazası, değer kaybı, manevi tazminat… Hangi tazminatı kimden isteyebilirsin, süre ne zaman doluyor? Tazminat bulucu ve zamanaşımı sayacı."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="kick">{cases.length} durum · bulucu · süre sayacı</p>
      <h1>Bu tazminat<br />kaç para?</h1>
      <p class="lede">
        Trafik kazası, iş kazası, değer kaybı, manevi tazminat… Hangi kalemleri kimden isteyebileceğini
        ve en önemlisi <strong>sürenin ne zaman dolduğunu</strong> gör.
      </p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a class="btn" href={url("/bulucu/")}>Hangi tazminatı isteyebilirim? →</a>
        <a class="btn btn-2" href={url("/zamanasimi/")}>Sürem doldu mu?</a>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:18px">
    <div class="wrap">
      <div class="grid g3">
        <a class="tool" href={url("/bulucu/")}><span class="ic">🔎</span><span><h3>Tazminat bulucu</h3><p>Olayını anlat, hangi kalemleri isteyebileceğini gör.</p></span></a>
        <a class="tool" href={url("/zamanasimi/")}><span class="ic">⏳</span><span><h3>Süre sayacı</h3><p>Olay tarihini gir, kaç günün kaldığını öğren.</p></span></a>
        <a class="tool" href={url("/liste/")}><span class="ic">📋</span><span><h3>{cases.length} durum</h3><p>Kaza, iş kazası, malpraktis, idare, sigorta.</p></span></a>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0"><div class="wrap">
    <div class="head"><h2>Durumunu ara</h2></div><SearchBox placeholder="Ara: değer kaybı, iş kazası, manevi…" />
  </div></section>

  <section class="block" style="padding-top:10px"><div class="wrap">
    <div class="head"><h2>En çok sorulanlar</h2><a href={url("/liste/")}>Tüm durumlar ({cases.length}) →</a></div>
    <div class="grid g2">{populer.map((c) => <CaseCard item={c} />)}</div>
  </div></section>

  <section class="block" style="padding-top:0"><div class="wrap">
    <div class="head"><h2>Çoğu kişinin bilmediği {surprising.length} nokta</h2></div>
    <div class="grid g2">{surprising.slice(0, 6).map((c) => <CaseCard item={c} hide />)}</div>
  </div></section>
</Base>

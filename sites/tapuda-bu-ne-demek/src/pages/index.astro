---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import CaseCard from "../components/CaseCard.astro";
import { cases, surprising, site } from "../lib/cases";
import { url, absUrl } from "../lib/url";

const dikkat = (cases as any[]).filter((c) => c.verdict === "a");
const populer = ["ipotek","hisseli-tapu","kat-irtifaki","aile-konutu-serhi","intifa-hakki","muhdesat-serhi"]
  .map((s) => cases.find((c) => c.slug === s)!);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": absUrl("/") + "#website", name: site.name, url: absUrl("/"), inLanguage: "tr-TR" },
    { "@type": "FAQPage", mainEntity: populer.map((c) => ({ "@type": "Question", name: c.question, acceptedAnswer: { "@type": "Answer", text: c.summary } })) },
  ],
};
---
<Base
  title="Tapuda bu ne demek? — şerh, takyidat ve tapu terimleri"
  description="İpotek, intifa, muhdesat, kat irtifakı, önalım… Tapu kaydındaki terimlerin ne anlama geldiğini ve hangisinin hakkınızı sınırladığını öğrenin."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="kick">{cases.length} tapu terimi · tapu okuyucu · terim testi</p>
      <h1>Tapuda bu<br />ne demek?</h1>
      <p class="lede">
        Hayatınızın en büyük alışverişini, <strong>anlamadığınız kelimelerle dolu</strong> bir belgeye
        güvenerek yapıyorsunuz. {dikkat.length} tanesi hakkınızı doğrudan sınırlıyor.
      </p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a class="btn" href={url("/tapu-oku/")}>Tapumu okut →</a>
        <a class="btn btn-2" href={url("/test/")}>Terim testini çöz</a>
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:20px"><div class="wrap">
    <div class="grid g3">
      <a class="tool" href={url("/tapu-oku/")}><span class="ic">📜</span><span><h3>Tapumu oku</h3><p>Kayıt metnini yapıştır, terimleri ayıklasın.</p></span></a>
      <a class="tool" href={url("/test/")}><span class="ic">🎓</span><span><h3>Terim testi</h3><p>10 soru — kaç tanesini biliyorsun?</p></span></a>
      <a class="tool" href={url("/liste/")}><span class="ic">🗂️</span><span><h3>{cases.length} terim</h3><p>Şerhler, takyidatlar, irtifaklar, beyanlar.</p></span></a>
    </div>
  </div></section>

  <section class="block" style="padding-top:6px"><div class="wrap">
    <div class="head"><h2>Terim ara</h2></div><SearchBox placeholder="Ara: ipotek, şerh, intifa, muhdesat…" />
  </div></section>

  <section class="block" style="padding-top:10px"><div class="wrap">
    <div class="head"><h2>En çok karşılaşılanlar</h2><a href={url("/liste/")}>Tümü ({cases.length}) →</a></div>
    <div class="grid g2">{populer.map((c) => <CaseCard item={c} />)}</div>
  </div></section>

  <section class="block" style="padding-top:0"><div class="wrap">
    <div class="head"><h2>Çoğu kişinin yanlış bildiği {surprising.length} terim</h2></div>
    <div class="grid g2">{surprising.slice(0, 6).map((c) => <CaseCard item={c} hide />)}</div>
  </div></section>
</Base>

---
import "../styles/hub.css";
import sites from "../../../sites.json";
import { readFileSync, existsSync } from "node:fs";

const BASE = import.meta.env.BASE_URL;
const url = (p: string) => (BASE + p.replace(/^\/+/, "")).replace(/\/{2,}/g, "/");
const site = (import.meta.env.SITE ?? "").replace(/\/$/, "");
const canonical = site + url("/");

/** Her sitenin senaryo sayısını kendi veri dosyasından oku (build anında). */
const counts: Record<string, number> = {};
for (const s of sites) {
  const p = new URL(`../../../sites/${s.slug}/src/data/cases.json`, import.meta.url).pathname;
  counts[s.slug] = existsSync(p) ? JSON.parse(readFileSync(p, "utf8")).length : 0;
}
const total = Object.values(counts).reduce((a, b) => a + b, 0);

const soon = [
  { t: "Delil olur mu?", d: "Ses kaydı, mesaj, kamera, tanık" },
  { t: "Trafikte kim haklı?", d: "Kaza krokisi ve kusur oranı" },
  { t: "Bu tazminat kaç para?", d: "Tüm tazminat türleri tek hesapta" },
  { t: "Ne kadar sürer?", d: "Dava ve işlem süreleri" },
  { t: "Miras kimin?", d: "Aile ağacı ile pay hesabı" },
  { t: "Emekli olabilir miyim?", d: "Prim günü ve emeklilik tarihi" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Hakkını Bil",
  url: canonical,
  inLanguage: "tr-TR",
  description: "Günlük hayatta karşılaşılan hukuki durumlar için kısa ve net cevaplar.",
};
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hakkını Bil — günlük hayatta hukuki durumlara net cevaplar</title>
    <meta name="description" content={`Tüketici, kira, boşanma ve daha fazlası. ${total} senaryo, hepsi tek soruya cevap veriyor: bu durumda hakkın ne?`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content="Hakkını Bil" />
    <meta property="og:description" content="Günlük hayatta karşılaşılan hukuki durumlara kısa ve net cevaplar." />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta name="theme-color" content="#0e0f13" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (() => { try { const t = localStorage.getItem("hb-theme"); if (t) document.documentElement.dataset.theme = t; } catch {} })();
    </script>
  </head>
  <body>
    <header class="top">
      <div class="in">
        <a class="brand" href={url("/")}>⚖️ Hakkını Bil</a>
        <button class="tbtn" id="theme" type="button" aria-label="Temayı değiştir">◐</button>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap">
          <p class="kick">{sites.length} site · {total} senaryo</p>
          <h1>Bu durumda<br />hakkın ne?</h1>
          <p>
            Günlük hayatta karşılaşılan hukuki durumlar, tek tek senaryolara ayrılmış.
            Hepsi aynı şeyi yapıyor: net bir cevap, dayanak madde ve ne yapman gerektiği.
          </p>
          <div class="search" data-search>
            <div class="sbox">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color:var(--ink-3);flex-shrink:0">
                <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
              </svg>
              <input type="search" autocomplete="off" spellcheck="false" placeholder="Tüm sitelerde ara: “depozito”, “kargo”, “tahliye”…" aria-label="Tüm sitelerde ara" />
            </div>
            <div class="results" data-results></div>
          </div>
        </div>
      </section>

      <section class="block">
        <div class="wrap">
          <div class="grid">
            {sites.map((s) => (
              <a class="site" href={url(`/${s.slug}/`)} style={`--dot:${s.accent}`}>
                <span class="n">{counts[s.slug]} senaryo</span>
                <span class="ico">{s.icon}</span>
                <h2>{s.name}</h2>
                <p class="q">{s.question}</p>
                <p>{s.blurb}</p>
                <span class="tools">{s.tools.map((t) => <span>{t}</span>)}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="block">
        <div class="wrap">
          <p class="head">Yapım aşamasında</p>
          <div class="soon">
            {soon.map((s) => <div><b>{s.t}</b>{s.d}</div>)}
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <p class="note">
          Bu sitelerdeki bilgiler genel bilgilendirme amaçlıdır, hukuki danışmanlık değildir ve
          avukat–müvekkil ilişkisi doğurmaz. Her olayın sonucu kendi koşullarına ve delil durumuna göre
          değişir; mevzuat ve parasal sınırlar zamanla güncellenir. Karar vermeden önce bir avukata danışın.
        </p>
        <p style="margin-top:16px">© {new Date().getFullYear()} Hakkını Bil · Açık kaynak · <a href="https://github.com/osmnnl/hukuk" rel="noopener">GitHub</a></p>
      </div>
    </footer>

    <span id="idx" data-base={BASE} data-src={url("/arama.json")} hidden></span>
    <script is:inline>
      document.getElementById("theme")?.addEventListener("click", () => {
        const el = document.documentElement;
        const next = el.dataset.theme === "light" ? "dark" : "light";
        el.dataset.theme = next;
        try { localStorage.setItem("hb-theme", next); } catch {}
      });

      const TR = {"ı":"i","İ":"i","ş":"s","Ş":"s","ğ":"g","Ğ":"g","ü":"u","Ü":"u","ö":"o","Ö":"o","ç":"c","Ç":"c","â":"a","î":"i","û":"u"};
      const norm = (s) => (s || "").toLowerCase().replace(/[ıİşŞğĞüÜöÖçÇâîû]/g, (m) => TR[m] || m);

      const meta = document.getElementById("idx");
      const root = document.querySelector("[data-search]");
      if (meta && root) {
        const BASE = meta.dataset.base || "/";
        let DATA = null, loading = null;
        const load = () => DATA ? Promise.resolve(DATA) : (loading ||= fetch(meta.dataset.src).then(r => r.json())
          .then(rows => (DATA = rows.map(d => ({ ...d, _t: norm(d.t), _q: norm(d.q), _a: norm(d.a) }))))
          .catch(() => (DATA = [])));

        const score = (d, terms) => {
          let tot = 0;
          for (const t of terms) {
            let b = 0;
            if (d._t.startsWith(t)) b = 100; else if (d._t.includes(t)) b = 70;
            else if (d._a.includes(t)) b = 55; else if (d._q.includes(t)) b = 40;
            if (!b) return 0;
            tot += b;
          }
          return tot;
        };

        const input = root.querySelector("input");
        const out = root.querySelector("[data-results]");
        let active = -1;

        const render = () => {
          active = -1;
          const q = input.value.trim();
          if (!q || !DATA) { out.innerHTML = ""; return; }
          const terms = norm(q).split(/\s+/).filter(Boolean);
          const list = DATA.map(d => ({ d, s: score(d, terms) })).filter(r => r.s > 0)
            .sort((a, b) => b.s - a.s || a.d._t.length - b.d._t.length).slice(0, 9).map(r => r.d);
          out.innerHTML = list.length
            ? list.map(d => `<a href="${BASE}${d.site}/${d.s}/"><span class="rt">${d.t}<span class="rs">${d.q}</span></span><span class="chip" style="background:${d.color}22;color:${d.color}">${d.siteName}</span></a>`).join("")
            : `<div class="empty">Eşleşen senaryo yok.</div>`;
        };

        input.addEventListener("input", () => load().then(render));
        input.addEventListener("focus", () => { load(); if (input.value) load().then(render); });
        input.addEventListener("keydown", (e) => {
          const items = [...out.querySelectorAll("a")];
          if (e.key === "ArrowDown" || e.key === "ArrowUp") {
            if (!items.length) return;
            e.preventDefault();
            active = e.key === "ArrowDown" ? (active + 1) % items.length : (active - 1 + items.length) % items.length;
            items.forEach((el, i) => el.classList.toggle("on", i === active));
            items[active].scrollIntoView({ block: "nearest" });
          } else if (e.key === "Enter") {
            const go = active >= 0 ? items[active] : items[0];
            if (go) { e.preventDefault(); location.href = go.href; }
          } else if (e.key === "Escape") { input.value = ""; out.innerHTML = ""; input.blur(); }
        });
        document.addEventListener("click", (e) => { if (!root.contains(e.target)) out.innerHTML = ""; });
      }
    </script>
  </body>
</html>
